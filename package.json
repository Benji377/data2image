{
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=packages/core",
    "lint": "eslint packages/*/src",
    "dev:web": "npm run dev --workspace=packages/web",
    "dev:cli": "npm run dev --workspace=packages/cli"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.18.2"
  }
}
