{
  "name": "@data2image/core",
  "version": "1.0.0",
  "description": "Convert any file to a PNG image and back. Isomorphic encoder/decoder library.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "data2image",
    "file-to-image",
    "encoder",
    "decoder",
    "png",
    "steganography"
  ],
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Benji377/data2image",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Benji377/data2image",
  "dependencies": {
    "pako": "^2.1.0",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "vitest": "^3.0.0",
    "@types/pako": "^2.0.3"
  }
}
